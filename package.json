{
  "name": "exit-velo-eval",
  "version": "0.1.0",
  "description": "Exit velocity, launch angle, and projected distance for baseball and softball from a phone camera, plus bat speed. Pure TypeScript, zero runtime dependencies.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "bench": "node bench/detector-bench.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "baseball",
    "softball",
    "exit-velocity",
    "launch-angle",
    "bat-speed",
    "computer-vision",
    "sports-science"
  ],
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "~5.9.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rader-ai/exit-velo-eval.git"
  },
  "homepage": "https://github.com/rader-ai/exit-velo-eval#readme"
}
